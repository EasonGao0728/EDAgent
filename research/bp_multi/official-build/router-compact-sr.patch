+  void countMask(DemandCounts& counts,int net,unsigned mask,int sign,bool filtered) const {
+    unsigned ignore=0;
+    if(filtered && _ignore) {
+      auto it=_ignore->find(net);
+      if(it!=_ignore->end()) for(auto o:it->second) ignore|=bit(o);
+    }
+    for(int o=1;o<=4;++o) if((mask & ~ignore) & (1u<<o)) counts.planar[o]+=sign;
+    if(!(mask&0x1e) && (mask&0x60) && !(ignore&0x60)) counts.vias+=sign;
+  }
+  void recount() {
+    _counts={};
+    for(const auto& [net,mask]:_nets) countMask(_counts,net,mask,1,true);
+  }
+  static unsigned bit(Orientation o) {return 1u<<static_cast<unsigned>(o);}
+  // Evaluate the hypothetical added wire without copying and updating two nested maps.
+  double measure(int candidate,unsigned extra,int mode,std::set<int>* overflow_nets=nullptr) {
+    if (!validDemandUnit()) RTLOG.error(Loc::current(),"Invalid space-routing demand units");
+    DemandCounts demand_counts=_counts;
+    if(!mode) {
+      demand_counts={};
+      for(const auto& [net,mask]:_nets) countMask(demand_counts,net,mask,1,false);
+    } else if(extra) {
+      auto it=std::lower_bound(_nets.begin(),_nets.end(),candidate,
+                               [](const auto& entry,int n){return entry.first<n;});
+      unsigned mask=it!=_nets.end() && it->first==candidate ? it->second : 0;
+      if((mask|extra)!=mask) {
+        countMask(demand_counts,candidate,mask,-1,true);
+        countMask(demand_counts,candidate,mask|extra,1,true);
+      }
+    }
+    const auto& counts=demand_counts.planar;
+    int vias=demand_counts.vias;
+    double boundary=0,internal=0,supply_sum=0;
+    auto overflow=[&](double d,double s){return mode==1 ? calcCost(d,s) : std::max(0.0,d-s);};
+    const auto& supplies=get_orient_supply_map();
+    for(int o=1;o<=4;++o) {
+      double demand=0;
+      if(mode) {
+        for(int k=0;k<counts[o];++k) {demand+=_boundary_wire_unit;internal+=_internal_wire_unit;}
+      } else {
+        demand=counts[o]*_boundary_wire_unit;
+        internal+=counts[o]*_internal_wire_unit;
+      }
+      const auto it=supplies.find(static_cast<Orientation>(o));
+      double supply=it==supplies.end()?0:it->second*_boundary_wire_unit;
+      if (overflow_nets && demand>supply)
+        for(const auto& [n,mask]:_nets) if(mask & (1u<<o)) overflow_nets->insert(n);
+      boundary+=mode ? overflow(demand,supply) : counts[o]*_boundary_wire_unit;
+    }
+    for(int k=0;k<vias;++k) internal+=_internal_via_unit;
+    for(const auto& [o,s]:supplies) supply_sum+=s*_internal_wire_unit;
+    if(overflow_nets && internal>supply_sum)
+      for(const auto& entry:_nets) overflow_nets->insert(entry.first);
+    return boundary+(mode ? overflow(internal,supply_sum) : internal);
