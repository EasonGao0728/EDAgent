+// The split at a partition edge can divide a preserved lead. Check exact
+// same-layer, collinear metal coverage of the full interval, including both ends.
+template<class Segments>
+bool coversLead(const Segments& wires,const LayerCoord& p,const LayerCoord& q) {
+  const bool h=p.get_y()==q.get_y();
+  if(p.get_layer_idx()!=q.get_layer_idx() || (h==(p.get_x()==q.get_x())))return false;
+  auto axis=[&](const LayerCoord& c){return h?c.get_x():c.get_y();};
+  auto cross=[&](const LayerCoord& c){return h?c.get_y():c.get_x();};
+  const int lo=std::min(axis(p),axis(q)),hi=std::max(axis(p),axis(q));
+  std::vector<std::pair<int,int>> spans;
+  for(auto s:wires) {
+    auto& a=s->get_first();auto& b=s->get_second();
+    if(a.get_layer_idx()!=p.get_layer_idx() || b.get_layer_idx()!=p.get_layer_idx() ||
+       cross(a)!=cross(p) || cross(b)!=cross(p))continue;
+    int l=std::max(lo,std::min(axis(a),axis(b))),r=std::min(hi,std::max(axis(a),axis(b)));
+    if(l<r)spans.emplace_back(l,r);
+  }
+  std::sort(spans.begin(),spans.end());
+  int covered=lo;
+  for(auto [l,r]:spans){if(l>covered)break;covered=std::max(covered,r);}
+  return covered==hi;
+}
