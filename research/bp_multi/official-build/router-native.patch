+
+std::vector<LayerCoord> nativeTargets(PAPin* pin)
+{
+  auto& layers = RTDM.getDatabase().get_routing_layer_list();
+  int32_t bottom = RTDM.getConfig().bottom_routing_layer_idx;
+  int32_t top = RTDM.getConfig().top_routing_layer_idx;
+  std::vector<LayerCoord> result;
+  for (auto& access : pin->get_access_point_list()) {
+    auto current = access.get_layer_idx();
+    int32_t target = std::clamp(current, bottom, top);
+    if (pin->get_is_core()) {
+      target = current >= top ? std::max(bottom, top - 1) : std::min(top, std::max(bottom, current) + 1);
+    }
+    auto& layer = layers.at(target);
+    int32_t reach = RTDM.getDatabase().get_detection_distance();
+    for (auto* axis : {&layer.getXTrackGridList(), &layer.getYTrackGridList()}) {
+      for (const auto& grid : *axis) reach = std::max(reach, grid.get_step_length() + layer.get_min_width());
+    }
+    auto rect = RTUTIL.getEnlargedRect(access.get_real_coord(), reach);
+    auto xs = RTUTIL.getScaleList(rect.get_ll_x(), rect.get_ur_x(), layer.getXTrackGridList());
+    auto ys = RTUTIL.getScaleList(rect.get_ll_y(), rect.get_ur_y(), layer.getYTrackGridList());
+    for (int32_t x : xs) for (int32_t y : ys) result.emplace_back(x, y, target);
+  }
+  std::sort(result.begin(), result.end(), CmpLayerCoordByXASC());
+  result.erase(std::unique(result.begin(), result.end()), result.end());
+  return result;
+}
+
+const std::vector<LayerCoord>& readTargets(PAPin* pin, std::vector<LayerCoord>& scratch)
+{
+  if (!lazyTargets()) return pin->get_target_coord_list();
+  scratch = nativeTargets(pin);
+  return scratch;
+}
+
+void writePAEvidence(PAModel& model)
+{
+  if (!useDefTracks()) return;
+  const char* witness = std::getenv("IEDA_RT_PA_WITNESS");
+  std::ofstream out;
+  if (witness) {
+    out.open(witness);
+    if (!out) RTLOG.error(Loc::current(), "Unable to open PA witness");
+    out << "net_idx\tnet\tpin_idx\tpin\tlayer\tx\ty\n";
+  }
+  size_t expected = 0, resolved = 0;
+  auto& layers = RTDM.getDatabase().get_routing_layer_list();
+  for (auto& net : model.get_pa_net_list()) {
+    auto* original = net.get_origin_net();
+    expected += original->get_pin_list().size();
+    std::set<int32_t> seen;
+    for (auto& pin : net.get_pa_pin_list()) {
+      auto& ap = pin.get_access_point();
+      int32_t level = ap.get_layer_idx();
+      bool inside = false;
+      for (auto& shape : pin.get_routing_shape_list()) {
+        if (shape.get_layer_idx() == level && RTUTIL.isInside(shape.get_real_rect(), ap.get_real_coord())) {
+          inside = true;
+          break;
+        }
+      }
+      if (level < 0 || level >= static_cast<int32_t>(layers.size()) || !inside || !seen.insert(pin.get_pin_idx()).second) {
+        RTLOG.error(Loc::current(), "Invalid PA net=", original->get_net_name(), " pin=", pin.get_pin_name());
+      }
+      if (witness) out << net.get_net_idx() << '\t' << original->get_net_name() << '\t' << pin.get_pin_idx() << '\t'
+                       << pin.get_pin_name() << '\t' << layers[level].get_layer_name() << '\t'
+                       << ap.get_real_coord().get_x() << '\t' << ap.get_real_coord().get_y() << '\n';
+      ++resolved;
+    }
+  }
+  if (witness) { out.close(); if (!out) RTLOG.error(Loc::current(), "Incomplete PA witness"); }
+  if (!expected || expected != resolved) RTLOG.error(Loc::current(), "Incomplete PA coverage");
+  RTLOG.info(Loc::current(), "EDA_PA_COVERAGE expected=", expected, " resolved=", resolved);
+  if (const char* gate = std::getenv("IEDA_RT_PA_GATE")) {
+    const std::string ready = std::string(gate) + ".ready", accept = std::string(gate) + ".accept";
+    if (std::ifstream(accept).good() || std::ifstream(ready).good()) RTLOG.error(Loc::current(), "Stale PA gate");
+    std::ofstream marker(ready); marker << resolved << '\n'; marker.close();
+    if (!marker) RTLOG.error(Loc::current(), "Could not publish PA gate");
+    for (int i=0; i<600; ++i) {
+      if (std::ifstream(accept).good()) return;
+      std::this_thread::sleep_for(std::chrono::milliseconds(100));
+    }
+    RTLOG.error(Loc::current(), "Independent PA acceptance timed out");
+  }
+}
