+// Rank access points by the nearest real planar exit from their via stack.
+// The DEF tick ranges are finite and have independent origins per layer.
+bool containsTick(int32_t value, const std::vector<ScaleGrid>& grids)
+{
+  for (const auto& g : grids) {
+    if (value >= g.get_start_line() && value <= g.get_end_line()
+        && (value - g.get_start_line()) % g.get_step_length() == 0) return true;
+  }
+  return false;
+}
+int32_t accessRank(AccessPoint& ap)
+{
+  auto& db = RTDM.getDatabase();
+  auto& layers = db.get_routing_layer_list();
+  const auto& cfg = RTDM.getConfig();
+  const auto& xy = ap.get_real_coord();
+  const int32_t level = ap.get_layer_idx();
+  if (level >= cfg.bottom_routing_layer_idx && level <= cfg.top_routing_layer_idx && onPreferredTrack(ap.getRealLayerCoord())) return 1000;
+  int32_t best = -1;
+  for (int32_t i = cfg.bottom_routing_layer_idx; i <= cfg.top_routing_layer_idx; ++i) {
+    auto& layer = layers[i];
+    bool x = containsTick(xy.get_x(), layer.getXTrackGridList());
+    bool y = containsTick(xy.get_y(), layer.getYTrackGridList());
+    if (!x && !y) continue;
+    bool preferred = layer.isPreferH() ? y : x;
+    int32_t score = 500 - 10 * std::abs(i-level) + (preferred ? 2 : 0);
+    if (i < cfg.top_routing_layer_idx && preferred && layer.isPreferH() != layers[i+1].isPreferH()) {
+      auto& next = layers[i+1];
+      if (containsTick(next.isPreferH() ? xy.get_y() : xy.get_x(),next.getPreferTrackGridList())) score += 4;
+    }
+    best = std::max(best, score);
+  }
+  return best;
+}
+struct FailedPin {
+  int32_t net, pin;
+  std::string detail;
+};
+struct FailedBox { std::vector<FailedPin> pins; };
+void reportUnresolved(const std::vector<FailedPin>& failed)
+{
+  if (failed.empty()) return;
+  auto& nets = RTDM.getDatabase().get_net_list();
+  const auto* witness = std::getenv("IEDA_RT_PA_WITNESS");
+  std::ofstream out;
+  if (witness) {
+    out.open(std::string(witness)+".unresolved.tsv");
+    if (!out) RTLOG.error(Loc::current(),"Could not create unresolved endpoint report");
+    out << "net_idx\tnet\tpin_idx\tpin\n";
+  }
+  size_t shown = 0;
+  for (const auto& failure : failed) {
+    auto& net = nets.at(failure.net);
+    auto& pin = net.get_pin_list().at(failure.pin);
+    if (witness) out << failure.net << '\t' << net.get_net_name() << '\t' << failure.pin << '\t' << pin.get_pin_name() << '\n';
+    if (++shown <= 32) RTLOG.warn(Loc::current(),"EDA_PA_UNRESOLVED net=",net.get_net_name()," pin=",pin.get_pin_name(),failure.detail);
+  }
+  if (witness) { out.close(); if (!out) RTLOG.error(Loc::current(),"Incomplete unresolved endpoint report"); }
+  RTLOG.error(Loc::current(),"Unresolved native PA endpoints: ",failed.size());
+}
