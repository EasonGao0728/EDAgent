+// Use the scheduled GCells for ownership. Extend only the physical search
+// window, and only toward local candidates of owned pins. The one-GCell
+// limit on each side keeps periodic same-color boxes disjoint. A macro with
+// several distant pin shapes must never create a box spanning the macro.
+bool workingRegion(PAModel& model, PABox& scheduled, EXTPlanarRect& result)
+{
+  auto& db = RTDM.getDatabase();
+  auto& base = scheduled.get_box_rect();
+  auto& grid = base.get_grid_rect();
+  auto& map = db.get_gcell_map();
+  PlanarRect allowed_grid(std::max(0,grid.get_ll_x()-1),std::max(0,grid.get_ll_y()-1),
+                          std::min(map.get_x_size()-1,grid.get_ur_x()+1),std::min(map.get_y_size()-1,grid.get_ur_y()+1));
+  auto allowed = RTUTIL.getRealRectByGCell(allowed_grid, db.get_gcell_axis());
+  auto rect = base.get_real_rect();
+  int32_t lx=rect.get_ll_x(), ly=rect.get_ll_y(), ux=rect.get_ur_x(), uy=rect.get_ur_y();
+  const int32_t reach = db.get_detection_distance();
+  std::set<std::pair<int32_t,int32_t>> owned;
+  for (const auto& [net_idx, points] : RTDM.getNetAccessPointMap(base)) {
+    auto& net = model.get_pa_net_list()[net_idx];
+    for (const auto* point : points) {
+      auto& pin = net.get_pa_pin_list()[point->get_pin_idx()];
+      const auto& owners = pin.get_grid_coord_set();
+      if (owners.empty() || !RTUTIL.isInside(grid,*owners.begin()) || !owned.emplace(net_idx,pin.get_pin_idx()).second) continue;
+      for (auto& candidate : pin.get_access_point_list()) {
+        const auto& p = candidate.get_real_coord();
+        if (!RTUTIL.isInside(allowed,p)) continue;
+        lx = std::min(lx,p.get_x()-reach); ly = std::min(ly,p.get_y()-reach);
+        ux = std::max(ux,p.get_x()+reach); uy = std::max(uy,p.get_y()+reach);
+      }
+    }
+  }
+  if (owned.empty()) return false;
+  PlanarRect search(std::max(lx,allowed.get_ll_x()),std::max(ly,allowed.get_ll_y()),
+                    std::min(ux,allowed.get_ur_x()),std::min(uy,allowed.get_ur_y()));
+  result.set_real_rect(search);
+  result.set_grid_rect(RTUTIL.getOpenGCellGridRect(search,db.get_gcell_axis()));
+  return true;
 }
 
